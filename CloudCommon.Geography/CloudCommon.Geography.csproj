<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>AngryMonkey.CloudCommon.Geography</PackageId>
    <Description>Explicit adapters between CloudCommon and existing CloudGeography value types.</Description>
    <Version>1.0.0</Version>
    <Authors>Angry Monkey</Authors>
    <Company>Angry Monkey</Company>
    <AssemblyVersion>$(PackageVersion)</AssemblyVersion>
    <FileVersion>$(PackageVersion)</FileVersion>
    <PackageIcon>amc-logo.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CloudCommon.Models/CloudCommon.Models.csproj" />
    <PackageReference Include="AngryMonkey.CloudGeography" Version="2.8.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="amc-logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
